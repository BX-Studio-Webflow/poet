# Workday Recruiting API (OAuth 2.0)
# Get these from Workday: API Clients for Integrations + Manage Refresh Tokens
# Token request sends client_id + client_secret in the form body (not Basic auth).

# Optional: preview vs live (omit for a single environment using only WORKDAY_* below)
# WORKDAY_PROFILE=preview
# WORKDAY_PROFILE=live

# Shared fallbacks when using WORKDAY_PROFILE, or the only set when WORKDAY_PROFILE is unset
WORKDAY_BASE_URL=https://wd2-impl-services1.workday.com/ccx
WORKDAY_TENANT=poet_preview
WORKDAY_CLIENT_ID=your_client_id
WORKDAY_CLIENT_SECRET=your_client_secret
WORKDAY_REFRESH_TOKEN=your_refresh_token

# When WORKDAY_PROFILE=preview — overrides WORKDAY_* for host, tenant, and OAuth (optional)
# WORKDAY_PREVIEW_BASE_URL=https://wd2-impl-services1.workday.com/ccx
# WORKDAY_PREVIEW_TENANT=poet_preview
# WORKDAY_PREVIEW_CLIENT_ID=
# WORKDAY_PREVIEW_CLIENT_SECRET=
# WORKDAY_PREVIEW_REFRESH_TOKEN=

# When WORKDAY_PROFILE=live — overrides WORKDAY_* (optional)
# WORKDAY_LIVE_BASE_URL=https://services1.myworkday.com/ccx
# WORKDAY_LIVE_TENANT=poet
# WORKDAY_LIVE_CLIENT_ID=
# WORKDAY_LIVE_CLIENT_SECRET=
# WORKDAY_LIVE_REFRESH_TOKEN=

# Optional: Base URL for career site (used when API returns relative externalPath)
# WORKDAY_CAREER_SITE_URL=https://poet.wd1.myworkdayjobs.com
